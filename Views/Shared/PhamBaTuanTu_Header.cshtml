@inject QltaiSanContext Db
@{
    var dsLoai = Db.LoaiTaiSans.OrderBy(x => x.MaLoai).ToList();
}
<header class="header">
    <div class="topbar">
        <div class="container">
            <span>Phòng Hành chính - Quản trị: <b>(024) 3999 8888</b> &nbsp;|&nbsp; Hỗ trợ: taisan@assethub.vn</span>
            <span>Xin chào, Quản trị viên &nbsp;|&nbsp; Đăng xuất</span>
        </div>
    </div>
    <div class="header-main">
        <div class="container">
            <a href="index.html"><img src="images/logo.png" alt="AssetHub" /></a>
            <div class="cart-box">Tổng tài sản: 16 - Nguyên giá: 3.125 triệu</div>
        </div>
    </div>
    <nav class="navbar">
        <div class="container">
            <ul class="menu">
                <li class="active"><a href="@Url.Action("Index", "Home")" class="loc-loai" data-url="@Url.Action("Loc", "Home")">Pham Ba Tuan Tu</a></li>
                @foreach (var lt in dsLoai)
                {
                    <li>
                        <a href="@Url.Action("Index", "Home", new { maLoai = lt.MaLoai})" class="loc-loai" 
                        data-url="@Url.Action("Loc", "Home", new { maLoai = lt.MaLoai})">@lt.TenLoai</a>
                    </li>
                }
            </ul>
            <form class="search-box">
                <input type="text" placeholder="Tìm tài sản..." />
                <button type="button">Tìm</button>
            </form>
        </div>
    </nav>
</header>